<Window x:Class="SnipText.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="snip-text settings"
        Height="320"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hotkey (e.g. Ctrl+Shift+O)" />
        <TextBox x:Name="HotkeyTextBox" Grid.Row="1" Margin="0,6,0,12" />

        <TextBlock Grid.Row="2" Text="OCR language tag (optional, e.g. en-US)" />
        <TextBox x:Name="OcrLanguageTagTextBox" Grid.Row="3" Margin="0,6,0,12" />

        <StackPanel Grid.Row="4" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Output mode:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="OutputModeComboBox" Width="180" />
            </StackPanel>

            <CheckBox x:Name="EnableLocalAiCheckBox"
                      Content="Enable local-AI recognizer (fallback feature)"
                      VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="CancelButton_OnClick" />
            <Button Content="Save"
                    Width="90"
                    IsDefault="True"
                    Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
