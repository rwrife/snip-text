<Window x:Class="SnipText.Capture.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipTextCaptureOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#8C000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross">
    <Grid>
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Stroke="#FF4FC3F7"
                       StrokeThickness="2"
                       Fill="#33FFFFFF" />
        </Canvas>
    </Grid>
</Window>
